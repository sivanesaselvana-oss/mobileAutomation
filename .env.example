# Copy to .env and adjust.

# Option A: install & launch an APK (put it in ./apps)
# APP_PATH=./apps/onebill.apk

# Option B: launch an already-installed app
APP_PACKAGE=com.onebill.oneso
APP_ACTIVITY=com.onebill.oneso.MainActivity

# Device selection — run `adb devices` to get the UDID of a real device/emulator
DEVICE_NAME=Android Emulator
# UDID=emulator-5554
# PLATFORM_VERSION=14

# Keep app data between sessions (skip re-login)
NO_RESET=false
