{
  "name": "one-bill-mobile-automation",
  "version": "1.0.0",
  "description": "One Bill Android automation - Appium + WebdriverIO + TypeScript",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --spec ./test/specs/smoke.spec.ts",
    "typecheck": "tsc -p tsconfig.json",
    "appium": "appium --relaxed-security",
    "emulator": "emulator -avd OneBill_Pixel_API34",
    "doctor": "appium driver doctor uiautomator2",
    "inspector": "appium --relaxed-security --allow-cors --use-plugins=inspector",
    "test:qr": "wdio run ./wdio.conf.ts --spec ./test/specs/qrcode.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.8.0",
    "appium-inspector-plugin": "^2026.9.2",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^18.0.8",
    "expect-webdriverio": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
